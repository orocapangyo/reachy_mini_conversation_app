# ==============================================================================
# 1. 한국어 데스크 동반자 (DeskMate) - OpenAI Realtime 설정 (기본값)
# ==============================================================================
# 대화 백엔드: "openai" (기본 권장) 또는 "hf" (Hugging Face)
CONVERSATION_BACKEND=openai


# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# 실시간 대화 모델: gpt-realtime-2.1, gpt-4o-realtime-preview, gpt-realtime-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 한국어 음성 (marin: 가장 자연스러운 한국어 추천, cedar, alloy, coral, shimmer 등)
OPENAI_VOICE=marin

# 한국어 음성 인식 언어 설정
REALTIME_TRANSCRIPTION_LANGUAGE=ko

# 기본 적용 프로필: 한국어 스마트 데스크 동반자
REACHY_MINI_CUSTOM_PROFILE=desk_companion_ko

# ==============================================================================
# 2. 로봇 데몬 연결 설정
# ==============================================================================
# MuJoCo 시뮬레이터 / 로컬 데몬: "sim" 또는 "localhost"
# 실물 로봇 연결 시 로봇 IP 지정 (예: 192.168.0.144)
REACHY_MINI_HOST=sim
REACHY_MINI_PORT=8000

# 데몬이 꺼져있을 때 자동 시작 활성화 (1: 켬, 0: 끔)
REACHY_MINI_AUTO_START_DAEMON=1

# 프로세스 종료(Ctrl+C) 시 안전 수면 자세(Sleep Pose) 복귀 (1: 켬, 0: 끔)
REACHY_MINI_SLEEP_ON_EXIT=1

# ==============================================================================
# 3. 스탠바이 및 음성 호출 (Wake Loop) 설정
# ==============================================================================
# 음성 "자러 가자" 명령 시 세션을 유지하며 절전 대기 모드 진입 (1: 켬, 0: 끔)
REACHY_MINI_STANDBY_ON_SLEEP=1

# 대기 상태에서 로봇을 깨우는 호출어 (쉼표 구분)
REACHY_MINI_WAKE_PHRASES=깨어나,리치미니,일어나,리치야,안녕

# 마이크 소음 차단(Noise Gate) 기본 감도 (0.0: 비활성화/자연 입력 권장, 0.01~1.0)
REACHY_MINI_NOISE_GATE_THRESHOLD=0.0

# reSpeaker 마이크 어레이 기반 음원 방향 추적 (DoA) 시선 정렬
REACHY_MINI_DOA_LOOK=1

# ==============================================================================
# 로컬 웨이크 워드 감지 (acoustic engine) 설정
# Gemini 백엔드 수면 재기동용: REACHY_MINI_WAKE_WORD_ENABLED=1 + CONVERSATION_BACKEND=gemini
# 활성화 시 "자러 가자" 명령이 Gemini 세션을 닫고 리스너를 시작합니다.
# ==============================================================================
# 로컬 음향 웨이크 워드 엔진 활성화 (기본: 0 = 비활성화, 1 = 활성화)
REACHY_MINI_WAKE_WORD_ENABLED=0

# 웨이크 워드 엔진 선택: "openwakeword" (기본) 또는 "mock" (테스트/시뮬용)
REACHY_MINI_WAKE_ENGINE=openwakeword

# 커스텀 학습 모델 경로 (.onnx 또는 .tflite). 비워두면 패키지에 포함된
# audio/models/reachy_mini_v4.onnx("리치미니")를 사용합니다 — 보통은 설정할 필요 없음.
# 주의: 음향 엔진이 감지하는 문구("리치미니")는 학습 시점에 고정됩니다.
#        문구를 변경하려면 재학습이 필요합니다. REACHY_MINI_WAKE_PHRASES(STT 전사 매칭용)와 별개입니다.
# REACHY_MINI_WAKE_MODEL_PATH=/path/to/custom_model.onnx

# 무조작 시 자동 절전 타임아웃 (분 단위, 기본 1440 = 24시간, 0은 비활성화)
REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# ==============================================================================
# 4. Google Calendar OAuth 설정 (선택 사항)
# ==============================================================================
# Google Cloud Console에서 생성한 웹 애플리케이션 OAuth 클라이언트 정보
# 승인된 리디렉션 URI: http://localhost:7860/api/calendar/oauth2callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==============================================================================
# 5. Gemini Live 백엔드 설정 (선택 사항 — CONVERSATION_BACKEND=gemini 시 필수)
# ==============================================================================
# CONVERSATION_BACKEND=gemini 로 설정하면 Gemini Live API 기반 음성 대화가 활성화됩니다.
# Google AI Studio (https://aistudio.google.com/app/apikey) 에서 발급한 API 키를 입력하세요.
# GEMINI_API_KEY=AIza...

# Gemini Live 실시간 오디오 모델 (기본값: gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Gemini 음성 이름 (기본값: Kore — 한국어 친화적)
# 사용 가능한 보이스: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
# GEMINI_VOICE=Kore

# ==============================================================================
# 6. Hugging Face 백엔드 설정 (선택 사항)
# ==============================================================================
# HF_REALTIME_CONNECTION_MODE=deployed
# HF_TOKEN=
# HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
