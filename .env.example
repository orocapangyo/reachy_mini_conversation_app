# ==============================================================================
# 1. 한국어 데스크 동반자 (DeskMate) - OpenAI Realtime 설정 (기본값)
# ==============================================================================
# 대화 백엔드: "openai" (기본 권장), "gemini" (5절, DeskMate 데모), "hf" (Hugging Face). 비우면 코드 기본값 hf
CONVERSATION_BACKEND=openai


# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# 실시간 대화 모델: gpt-realtime-2.1, gpt-4o-realtime-preview, gpt-realtime-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 한국어 음성 (marin: 가장 자연스러운 한국어 추천, cedar, alloy, coral, shimmer 등)
OPENAI_VOICE=marin

# 한국어 음성 인식 언어 설정
REALTIME_TRANSCRIPTION_LANGUAGE=ko

# 기본 적용 프로필: 한국어 스마트 데스크 동반자
REACHY_MINI_CUSTOM_PROFILE=desk_companion_ko

# ==============================================================================
# 2. 로봇 데몬 연결 설정
# ==============================================================================
# MuJoCo 시뮬레이터 / 로컬 데몬: "sim" 또는 "localhost"
# 실물 로봇 연결 시 로봇 IP 지정 (예: 192.168.0.144)
# 시뮬 데몬은 별도 터미널에서 먼저 띄운다 (추가 설치 없음, 뷰어 없음): reachy-mini-daemon --mockup-sim --headless --no-media
# 뷰어가 필요하면 README "시뮬레이터 데몬 띄우기" 절 참고.
REACHY_MINI_HOST=sim
REACHY_MINI_PORT=8000

# 데몬이 꺼져있을 때 자동 시작 활성화 (1: 켬, 0: 끔)
REACHY_MINI_AUTO_START_DAEMON=1

# 프로세스 종료(Ctrl+C) 시 안전 수면 자세(Sleep Pose) 복귀 (1: 켬, 0: 끔)
REACHY_MINI_SLEEP_ON_EXIT=1

# ==============================================================================
# 3. 스탠바이 및 음성 호출 (Wake Loop) 설정
# ==============================================================================
# 음성 "자러 가자" 명령 시 세션을 유지하며 절전 대기 모드 진입 (1: 켬, 0: 끔)
REACHY_MINI_STANDBY_ON_SLEEP=1

# 대기 상태에서 로봇을 깨우는 호출어 (쉼표 구분)
REACHY_MINI_WAKE_PHRASES=깨어나,리치미니,일어나,리치야,안녕

# 마이크 소음 차단(Noise Gate) 기본 감도 (0.0: 비활성화/자연 입력 권장, 0.01~1.0)
REACHY_MINI_NOISE_GATE_THRESHOLD=0.0

# reSpeaker 마이크 어레이 기반 음원 방향 추적 (DoA) 시선 정렬
REACHY_MINI_DOA_LOOK=1

# ==============================================================================
# 로컬 웨이크 워드 감지 (acoustic engine) 설정
# Gemini 백엔드 수면 재기동용: REACHY_MINI_WAKE_WORD_ENABLED=1 + CONVERSATION_BACKEND=gemini
# 활성화 시 "자러 가자" 명령이 Gemini 세션을 닫고 리스너를 시작합니다.
# ==============================================================================
# 로컬 음향 웨이크 워드 엔진 활성화 (기본: 0 = 비활성화, 1 = 활성화)
REACHY_MINI_WAKE_WORD_ENABLED=0

# 웨이크 워드 엔진 선택: "openwakeword" (기본) 또는 "mock" (테스트/시뮬용)
REACHY_MINI_WAKE_ENGINE=openwakeword

# 커스텀 학습 모델 경로 (.onnx 또는 .tflite). 비워두면 패키지에 포함된
# audio/models/reachy_mini_v4.onnx("리치미니")를 사용합니다 — 보통은 설정할 필요 없음.
# 주의: 음향 엔진이 감지하는 문구("리치미니")는 학습 시점에 고정됩니다.
#        문구를 변경하려면 재학습이 필요합니다. REACHY_MINI_WAKE_PHRASES(STT 전사 매칭용)와 별개입니다.
# REACHY_MINI_WAKE_MODEL_PATH=/path/to/custom_model.onnx

# 무조작 시 자동 절전 타임아웃 (분 단위, 기본 1440 = 24시간, 0은 비활성화)
REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# ==============================================================================
# 4. Google Calendar OAuth 설정 (선택 사항)
# ==============================================================================
# Google Cloud Console에서 생성한 웹 애플리케이션 OAuth 클라이언트 정보
# 승인된 리디렉션 URI: http://localhost:7860/api/calendar/oauth2callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==============================================================================
# 5. Gemini Live 백엔드 설정 (선택 사항 — CONVERSATION_BACKEND=gemini 시 필수)
# ==============================================================================
# CONVERSATION_BACKEND=gemini 로 설정하면 Gemini Live API 기반 음성 대화가 활성화됩니다.
# Google AI Studio (https://aistudio.google.com/app/apikey) 에서 발급한 API 키를 입력하세요.
# GEMINI_API_KEY=AIza...

# Gemini Live 실시간 오디오 모델 (기본값: gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Gemini 음성 이름 (기본값: Kore — 한국어 친화적)
# 사용 가능한 보이스: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
# GEMINI_VOICE=Kore

# ==============================================================================
# 6. Hugging Face 백엔드 설정 (선택 사항)
# ==============================================================================
# HF_REALTIME_CONNECTION_MODE=deployed
# HF_TOKEN=
# HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# ==============================================================================
# 7. Bookmark Insight (북마크 인사이트) (설계: oss_plan/2026-11-06-weekly-insight-design.md §2.3)
# ==============================================================================
# 아래 세 값(저장소·Chrome 경로·프로필)은 터미널 없이도 설정할 수 있다:
# reachy-mini-conversation-app --ui → http://127.0.0.1:7860/#/settings → Bookmark Insight 섹션의
# 버튼(프로필 탐색 → 폴더 만들기·적용 → .env에 적용 → 동기화 실행)이 이 파일에 직접 쓴다. 상세: src/bookmark_insight/SETUP.md
# 북마크 저장소(옵시디언 볼트) 경로. 비어 있으면 인사이트 도구가 "설정 안 됨" 오류를 돌려준다.
# BOOKMARK_INSIGHT_BOOKMARK_REPO=~/Documents/bookmarks
# 대시보드는 옵시디언 전역 설정(obsidian.json)에서 볼트를 찾아 그 안의 폴더를 추천한다. 옵시디언을 다른 곳에 설치했으면 파일 위치를 지정.
# BOOKMARK_INSIGHT_OBSIDIAN_CONFIG=

# Chrome "User Data" 경로. 비우면 OS별 기본 위치를 자동 탐색한다.
# macOS: ~/Library/Application Support/Google/Chrome, Windows: %LOCALAPPDATA%\Google\Chrome\User Data
# 내 PC의 프로필·북마크 파일 확인: python -m bookmark_insight.sync --discover (출력된 .env 줄을 복사).
# 안 잡히면 Chrome에서 chrome://version 의 "프로필 경로" 참고.
# Chrome에 구글 계정으로 로그인한 프로필은 북마크를 Bookmarks 대신 AccountBookmarks 파일에 두는데, 둘 다 읽는다.
# BOOKMARK_INSIGHT_CHROME_USER_DATA_DIR=

# 읽을 Chrome 프로필 허용 목록(폴더명, 쉼표 구분). 비우면 마지막 사용 프로필 하나만.
# 목록에 없는 프로필은 파일이 있어도 읽지 않는다 (타인·회사 프로필 보호).
# BOOKMARK_INSIGHT_CHROME_PROFILES=Default
# 대화에서 profile 인자를 생략했을 때 대상 프로필 (기본: 허용 목록 첫 항목)
# BOOKMARK_INSIGHT_DEFAULT_PROFILE=Default

# 포함 폴더(비우면 전체. 예: bookmark_bar/개발) / 제외 폴더(이름만, 기본 private)
# BOOKMARK_INSIGHT_INCLUDE_FOLDERS=
# BOOKMARK_INSIGHT_EXCLUDE_FOLDERS=private
# 동기화 시작 날짜(ISO). 비우면 전체 이력.
# BOOKMARK_INSIGHT_SYNC_SINCE=

# 인사이트 노트 폴더 (기본 <저장소>/insights). 지정하면 아래 NOTE_LINKS=auto 판정도 이 폴더 기준.
# BOOKMARK_INSIGHT_INSIGHTS_DIR=
# 노트 프런트매터 related:에 북마크 [[파일 링크]](옵시디언 그래프·백링크용)를 쓸지: auto(기본)=노트 폴더가 옵시디언 볼트(.obsidian/) 안일 때만, on=항상, off=안 씀.
# 본문의 북마크 줄은 설정과 무관하게 웹 링크 [제목](URL)이다.
# BOOKMARK_INSIGHT_NOTE_LINKS=auto
# 본문을 가져오지 않을 URL 패턴 추가분(쉼표 구분). 사설 대역·localhost는 항상 제외.
# BOOKMARK_INSIGHT_EXCLUDE_URL_PATTERNS=
# 인사이트 대화 자동 종료 무응답 시간(분)
# BOOKMARK_INSIGHT_INSIGHT_IDLE_TIMEOUT_MIN=10
# 대화 로그 폴더(세션당 JSONL 1개, 외부 전송 없음) / 토큰 사용량 로그 파일 (기본 <저장소>/.bookmark_insight/…)
# BOOKMARK_INSIGHT_CONVERSATION_LOG_DIR=
# BOOKMARK_INSIGHT_USAGE_LOG=
# 깃 미러 (M9, 기본 끔). 켜면 동기화가 만든/바꾼/보관한 북마크 파일을 북마크 날짜로 커밋한다 (git 설치 필요).
# 과거 이력 재구성: python -m bookmark_insight.sync --git-rebuild
# BOOKMARK_INSIGHT_GIT_MIRROR=0

# 배치(요약·상관관계)용 텍스트 모델. GEMINI_API_KEY를 같이 쓴다. 비어 있으면 가짜 모델로 동작. (3.8-flash는 호출당 4분 이상 걸리는 것이 실측됨, 2026-11-07)
# BOOKMARK_INSIGHT_BATCH_MODEL=gemini-3.5-flash
# 북마크당 LLM에 보내는 본문 상한 글자 수 / 한 요청에서 즉시 요약하는 최대 건수
# BOOKMARK_INSIGHT_BODY_MAX_CHARS=20000
# BOOKMARK_INSIGHT_BATCH_MAX_SUMMARIES=20
# 하루 최대 요약 건수 (무료 등급 한도 보호. 넘으면 다음 날 이어서 백필) / 요약 호출 간격(초, 분당 요청 한도 보호)
# BOOKMARK_INSIGHT_DAILY_MAX_SUMMARIES=100
# BOOKMARK_INSIGHT_CALL_INTERVAL_S=6
